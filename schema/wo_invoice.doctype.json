{
  "name": "WO Invoice",
  "module": "Lamicar Services",
  "custom": 1,
  "autoname": "format:{voucher_type}-{letter}-{point_of_sale}-{number}",
  "naming_rule": "Expression",
  "title_field": "customer_name",
  "search_fields": "customer_name,tax_id,date",
  "sort_field": "date",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    { "fieldname": "voucher_type", "label": "Tipo", "fieldtype": "Select", "options": "FC\nNC\nND", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "FC = factura, NC = nota de crédito, ND = nota de débito" },
    { "fieldname": "letter", "label": "Letra", "fieldtype": "Select", "options": "A\nB\nC\nM\nE", "reqd": 1 },
    { "fieldname": "point_of_sale", "label": "Punto de venta", "fieldtype": "Data", "reqd": 1, "description": "Con ceros a la izquierda, como en el comprobante (ej. 00003)" },
    { "fieldname": "number", "label": "Número", "fieldtype": "Data", "reqd": 1, "description": "Con ceros a la izquierda (ej. 00001234)" },
    { "fieldname": "date", "label": "Fecha", "fieldtype": "Date", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "status", "label": "Estado", "fieldtype": "Select", "options": "Registrado\nAnulado", "default": "Registrado", "in_standard_filter": 1 },
    { "fieldname": "col_cliente", "fieldtype": "Column Break" },
    { "fieldname": "client_id", "label": "Cliente", "fieldtype": "Link", "options": "WO Client", "in_standard_filter": 1 },
    { "fieldname": "customer_name", "label": "Cliente (razón social)", "fieldtype": "Data", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "tax_id", "label": "CUIT / DNI", "fieldtype": "Data" },
    { "fieldname": "branch_id", "label": "Sucursal", "fieldtype": "Link", "options": "WO Branch", "in_standard_filter": 1 },
    { "fieldname": "against_invoice", "label": "Comprobante asociado", "fieldtype": "Link", "options": "WO Invoice", "description": "Para NC / ND: la factura que ajusta" },
    { "fieldname": "sec_importes", "label": "Importes", "fieldtype": "Section Break" },
    { "fieldname": "net_amount", "label": "Neto", "fieldtype": "Currency", "reqd": 1 },
    { "fieldname": "tax_amount", "label": "IVA / impuestos", "fieldtype": "Currency" },
    { "fieldname": "total_amount", "label": "Total", "fieldtype": "Currency", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "sec_ots", "label": "Imputación a órdenes de trabajo", "fieldtype": "Section Break" },
    { "fieldname": "items", "label": "Órdenes", "fieldtype": "Table", "options": "WO Invoice Line", "reqd": 1 },
    { "fieldname": "sec_archivo", "label": "Archivo e integración", "fieldtype": "Section Break" },
    { "fieldname": "file_url", "label": "PDF del comprobante", "fieldtype": "Attach" },
    { "fieldname": "notes", "label": "Observaciones", "fieldtype": "Small Text" },
    { "fieldname": "tango_id", "label": "ID en Tango", "fieldtype": "Data", "read_only": 1 },
    { "fieldname": "tango_synced_at", "label": "Sincronizado con Tango", "fieldtype": "Datetime", "read_only": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1 },
    { "role": "WO Admin", "read": 1, "write": 1, "create": 1 },
    { "role": "WO Facturador", "read": 1, "write": 1, "create": 1 },
    { "role": "WO Recepcion", "read": 1 },
    { "role": "WO Auditor", "read": 1 }
  ]
}
