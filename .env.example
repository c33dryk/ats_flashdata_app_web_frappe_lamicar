# Copiar a .env (en la raíz, junto a docker-compose.yml) y completar valores reales.
# .env está en .gitignore — nunca commitear credenciales reales.

# --- Frappe Cloud (backend de datos, externo) ---
FRAPPE_URL=https://tu-sitio.frappe.cloud
# Service account: Frappe > Settings > API Access > Generate Keys.
# Se usa para todas las llamadas server-side a /api/resource y /api/method (Authorization: token key:secret).
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# --- Branding (por cliente/proyecto) ---
# Color de acento configurable sin tocar código — reemplazar por el color de marca del cliente
# (ej. el verde de Lamicar). Se usa en acentos puntuales (logo del sidebar, item de nav activo,
# variant="brand" de Button/Badge). Cualquier valor CSS válido (hex, rgb(), oklch()...).
# Entre comillas: sin ellas, el parser de env de Next.js interpreta el "#" como inicio de
# comentario y el valor queda vacío.
BRAND_COLOR="#0f172a"

# --- App ---
APP_PORT=3001
SESSION_SECRET=cambiar-esto-por-una-cadena-larga-random
# En true recién cuando haya HTTPS real delante (reverse proxy). En false/sin setear, la cookie
# de sesión funciona por http:// plano (dev, Docker local, etc.).
SESSION_COOKIE_SECURE=false

# --- Producción (VersatileHub, ver docker-compose.prod.yml) ---
# Dominio público servido vía Traefik, y puerto interno que expone el contenedor (no se publica
# al host, solo lo consume Traefik dentro de la red "web").
LAMICAR_PORTAL_DOMAIN=portal.lamicar.app
LAMICAR_PORTAL_APP_PORT=3000
