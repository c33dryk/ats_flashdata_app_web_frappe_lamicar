# Copiar a .env (en la raíz, junto a docker-compose.yml) y completar valores reales.
# .env está en .gitignore — nunca commitear credenciales reales.

# --- Frappe Cloud (backend de datos, externo) ---
FRAPPE_URL=https://tu-sitio.frappe.cloud
# Service account: Frappe > Settings > API Access > Generate Keys.
# Se usa para todas las llamadas server-side a /api/resource y /api/method (Authorization: token key:secret).
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# --- App ---
APP_PORT=3001
SESSION_SECRET=cambiar-esto-por-una-cadena-larga-random
# En true recién cuando haya HTTPS real delante (reverse proxy). En false/sin setear, la cookie
# de sesión funciona por http:// plano (dev, Docker local, etc.).
SESSION_COOKIE_SECURE=false
